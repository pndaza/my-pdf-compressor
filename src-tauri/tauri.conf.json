{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "My PDF Compressor",
  "version": "0.1.0",
  "identifier": "com.mypdfcompressor.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "My PDF Compressor",
        "width": 1100,
        "height": 750,
        "resizable": true,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "Apple Development: Pinnyar Daza (Q5F84CH2NB)"
    }
  }
}
